+
+package adjuster
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"go.opentelemetry.io/collector/pdata/pcommon"
+	"go.opentelemetry.io/collector/pdata/ptrace"
+)
+
+func TestFillGapsAndExtendAdjuster(t *testing.T) {
+	type testSpan struct {
+		id, parent, endParent [8]byte
+		startTime, duration int
+	}
+
+	toTime := func(t int) time.Time {
+		return time.Unix(0, (time.Duration(t) * time.Millisecond).Nanoseconds())
+	}
+
+	// helper function that constructs a trace from a list of span prototypes
+	makeTrace := func(spanPrototypes []testSpan) ptrace.Traces {
+		trace := ptrace.NewTraces()
+		for _, spanProto := range spanPrototypes {
+			traceID := pcommon.TraceID([16]byte{0, 0, 0, 0, 0, 0, 0, 1})
+			span := ptrace.NewSpan()
+			span.SetTraceID(traceID)
+			span.SetSpanID(spanProto.id)
+			span.SetParentSpanID(spanProto.parent)
+			span.SetStartTimestamp(pcommon.NewTimestampFromTime(toTime(spanProto.startTime)))
+			span.SetEndTimestamp(pcommon.NewTimestampFromTime(toTime(spanProto.startTime + spanProto.duration)))
+			if spanProto.endParent != spanProto.parent {
+				addEndParentToSpan(&span, spanProto.endParent)
+			}
+			resource := ptrace.NewResourceSpans()
+
+			span.CopyTo(resource.ScopeSpans().AppendEmpty().Spans().AppendEmpty())
+			resource.CopyTo(trace.ResourceSpans().AppendEmpty())
+		}
+		return trace
+	}
+	rootSpanID := [8]byte{0, 0, 0, 0, 0, 0, 0, 1}
+
+	testCases := []struct {
+		description string
+		trace       []testSpan
+		expectedStartTimes map[pcommon.SpanID]time.Time
+		expectedEndTimes map[pcommon.SpanID]time.Time
+	}{
+		{
+			description: "async operation with end parent same as start parent",
+			trace: []testSpan{
+				{id: [8]byte{1}, parent: [8]byte{0}, endParent: [8]byte{0}, startTime: 0, duration: 100},
+				{id: [8]byte{2}, parent: [8]byte{1}, endParent: [8]byte{1}, startTime: 10, duration: 20},
+				{id: [8]byte{3}, parent: [8]byte{2}, endParent: [8]byte{2}, startTime: 30, duration: 50},
+			},
+			expectedStartTimes: map[pcommon.SpanID]time.Time{rootSpanID: toTime(0).UTC(), [8]byte{1}: toTime(0).UTC(), [8]byte{2}: toTime(10).UTC(), [8]byte{3}: toTime(30).UTC()},
+			expectedEndTimes: map[pcommon.SpanID]time.Time{rootSpanID: toTime(100).UTC(), [8]byte{1}: toTime(100).UTC(), [8]byte{2}: toTime(80).UTC(), [8]byte{3}: toTime(80).UTC()},
+
+		},
+		{
+			description: "async operation with different end parent",
+			trace: []testSpan{
+				{id: [8]byte{1}, parent: [8]byte{0}, endParent: [8]byte{0}, startTime: 0, duration: 100},
+				{id: [8]byte{2}, parent: [8]byte{1}, endParent: [8]byte{1}, startTime: 10, duration: 10},
+				{id: [8]byte{3}, parent: [8]byte{1}, endParent: [8]byte{1}, startTime: 70, duration: 20},
+				{id: [8]byte{4}, parent: [8]byte{2}, endParent: [8]byte{3}, startTime: 30, duration: 50}, //start will be extended back to 20 to fill the gap
+			},
+			expectedStartTimes: map[pcommon.SpanID]time.Time{rootSpanID: toTime(0).UTC(), [8]byte{1}: toTime(0).UTC(), [8]byte{2}: toTime(10).UTC(), [8]byte{3}: toTime(70).UTC(), [8]byte{4}: toTime(20).UTC()},
+			expectedEndTimes: map[pcommon.SpanID]time.Time{rootSpanID: toTime(100).UTC(), [8]byte{1}: toTime(100).UTC(), [8]byte{2}: toTime(20).UTC(), [8]byte{3}: toTime(90).UTC(), [8]byte{4}: toTime(80).UTC()},
+		},
+		{
+			description: "async operation with NULL end parent",
+			trace: []testSpan{
+				{id: [8]byte{1}, parent: [8]byte{0}, endParent: [8]byte{0}, startTime: 0, duration: 100},
+				{id: [8]byte{2}, parent: [8]byte{1}, endParent: [8]byte{1}, startTime: 10, duration: 10},
+				{id: [8]byte{3}, parent: [8]byte{2}, endParent: [8]byte{0}, startTime: 30, duration: 50}, //start will be extended back to 20 to fill the gap
+			},
+			expectedStartTimes: map[pcommon.SpanID]time.Time{rootSpanID: toTime(0).UTC(), [8]byte{1}: toTime(0).UTC(), [8]byte{2}: toTime(10).UTC(), [8]byte{3}: toTime(20).UTC()},
+			expectedEndTimes: map[pcommon.SpanID]time.Time{rootSpanID: toTime(100).UTC(), [8]byte{1}: toTime(100).UTC(), [8]byte{2}: toTime(20).UTC(), [8]byte{3}: toTime(80).UTC()},
+		},
+	}
+
+	for _, tt := range testCases {
+		testCase := tt // capture loop var
+		t.Run(testCase.description, func(t *testing.T) {
+			trace := makeTrace(testCase.trace)
+			//dropped span adjustments require adding the root span
+			rootSpanAdjuster := AddRootSpan(true)
+			rootSpanAdjuster.Adjust(trace)
+
+			droppedSpanAdjuster := FillGapsAndExtendParents(true)
+			droppedSpanAdjuster.Adjust(trace)
+
+			resources := trace.ResourceSpans()
+			for i := 0; i < resources.Len(); i++ {
+				resource := resources.At(i)
+				scopes := resource.ScopeSpans()
+				for j := 0; j < scopes.Len(); j++ {
+					spans := scopes.At(j).Spans()
+					for k := 0; k < spans.Len(); k++ {
+						span := spans.At(k)
+						assert.Equal(t, testCase.expectedStartTimes[span.SpanID()], span.StartTimestamp().AsTime())
+						assert.Equal(t, testCase.expectedEndTimes[span.SpanID()], span.EndTimestamp().AsTime())
+					}
+				}
+			}
+		})
+	}
+}
