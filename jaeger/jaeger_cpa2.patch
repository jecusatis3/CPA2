+++ b/cmd/jaeger/internal/extension/jaegerquery/internal/adjuster/cpa2_common.go
@@ -0,0 +1,143 @@
+
+package adjuster
+
+import (
+	"encoding/hex"
+    "encoding/binary"
+	"time"
+	"go.opentelemetry.io/collector/pdata/pcommon"
+	"go.opentelemetry.io/collector/pdata/ptrace"
+	"github.com/jaegertracing/jaeger/internal/telemetry/otelsemconv"
+)
+
+// default value is 0000000000000001, but will be incremented if that is already used in the trace
+func getRootSpanID(spanIDs map[pcommon.SpanID]struct{}) pcommon.SpanID{
+    rootSpanID := pcommon.SpanID([8]byte{0, 0, 0, 0, 0, 0, 0, 1})
+    for true {
+        if _, inSpans := spanIDs[rootSpanID]; !inSpans {
+            return rootSpanID
+        } else {
+            rootSpanID = incrementSpanID(rootSpanID)
+        }
+    }
+
+
+    var rootSpanIDNum uint64
+    rootSpanIDNum = 1
+    for true {
+        var rootSpanIDBytes [8]byte
+        binary.LittleEndian.PutUint64(rootSpanIDBytes[:], rootSpanIDNum)
+        if _, inSpans := spanIDs[rootSpanIDBytes]; !inSpans {
+            return rootSpanIDBytes
+        } else {
+            rootSpanIDNum += 1
+        }
+    }
+    return pcommon.NewSpanIDEmpty()
+}
+
+// returns earliest timestamp
+func getMinTime() pcommon.Timestamp {
+	return pcommon.NewTimestampFromTime(time.Time{})
+}
+
+// not actually max time, but set to the end of 2126, 100 years from now
+func getMaxTime() pcommon.Timestamp {
+	return pcommon.NewTimestampFromTime(time.Date(2126, 12, 31, 23, 59, 59, 999999999, time.UTC))
+}
+
+// get duration by subtracting start timestamp from end timestamp
+func getSpanDuration(span ptrace.Span) time.Duration {
+    return span.EndTimestamp().AsTime().Sub(span.StartTimestamp().AsTime())
+}
+
+// remove an item from the "set" (map with empty structure) and return its key
+func pop(spanIDSet map[pcommon.SpanID]struct{}) pcommon.SpanID {
+    var retID pcommon.SpanID
+    for key := range spanIDSet {
+        retID = key
+        delete(spanIDSet, key)
+        return retID
+    }
+    return pcommon.NewSpanIDEmpty()
+}
+
+// gets service name from resource
+func getServiceName(resource ptrace.ResourceSpans) string {
+    if attr, ok := resource.Resource().Attributes().Get(string(otelsemconv.ServiceNameKey)); ok {
+		return attr.Str()
+	}
+    return ""
+}
+
+// gets host information from resource: returns hostID string, host IPs slice, single host IP string, and host name if any are set
+// (else all are returned empty)
+func getHostInformation(resource ptrace.ResourceSpans) (string, []string, string, string) {
+    hostID := ""
+    hostIPs := []string{}
+    hostIP_string := ""
+    hostName := ""
+
+	if attr, ok := resource.Resource().Attributes().Get(string(otelsemconv.HostIDKey)); ok {
+		hostID = attr.Str()
+	}
+	if attr, ok := resource.Resource().Attributes().Get(string(otelsemconv.HostIPKey)); ok {
+		if attr.Type() == pcommon.ValueTypeStr {
+			hostIP_string = attr.Str()
+		} else if attr.Type() == pcommon.ValueTypeSlice {
+			ips := attr.Slice()
+            for i := 0; i < ips.Len(); i++ {
+                hostIPs[i] = ips.At(i).AsString()
+			}
+		}
+	}
+	if attr, ok := resource.Resource().Attributes().Get(string(otelsemconv.HostNameKey)); ok {
+		hostName = attr.Str()
+	}
+    return hostID, hostIPs, hostIP_string, hostName
+}
+
+// finds end parent attribute if exists and returns the string id stored there as a span id
+// if the end parent attribute is not set, return the id of the start parent
+func findEndParent(span ptrace.Span) (pcommon.SpanID, bool) {
+    spanid_val, found := span.Attributes().Get("end_parent")
+    if found {
+        // convert string to span id
+        spanid_string := spanid_val.AsString()
+        spanid_bytes, _ := hex.DecodeString(spanid_string)
+
+        final_spanid := pcommon.NewSpanIDEmpty()
+        for index, byte := range spanid_bytes {
+            final_spanid[index] = byte
+        }
+        return final_spanid, found
+    }
+
+    return span.ParentSpanID(), found
+}
+
+// add end parent attribute to span
+func addEndParentToSpan(span *ptrace.Span, endParentID pcommon.SpanID) {
+    // convert pcommon.SpanID to []byte{} so hex.EncodeToString can be used
+    endParentID_bytes := []byte{}
+    for _, b := range endParentID {
+        endParentID_bytes = append(endParentID_bytes, b)
+    }
+    span.Attributes().PutStr("end_parent", hex.EncodeToString(endParentID_bytes))
+}
+
+// returns the smaller timestamp of the two
+func minTime(t1 pcommon.Timestamp, t2 pcommon.Timestamp) pcommon.Timestamp {
+    if t1.AsTime().Compare(t2.AsTime()) <= 0 { //if tie, return t1
+        return t1
+    }
+    return t2
+}
+
+// returns the larger timestamp of the two
+func maxTime(t1 pcommon.Timestamp, t2 pcommon.Timestamp) pcommon.Timestamp {
+    if t1.AsTime().Compare(t2.AsTime()) >= 0 { //if tie, return t1
+        return t1
+    }
+    return t2
+}
