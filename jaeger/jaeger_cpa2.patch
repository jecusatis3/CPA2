+
+package adjuster
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"go.opentelemetry.io/collector/pdata/pcommon"
+	"go.opentelemetry.io/collector/pdata/ptrace"
+)
+
+func TestDroppedSpanAdjuster(t *testing.T) {
+	type testSpan struct {
+		id, parent          [8]byte
+		startTime, duration int
+	}
+
+	toTime := func(t int) time.Time {
+		return time.Unix(0, (time.Duration(t) * time.Millisecond).Nanoseconds())
+	}
+
+	// helper function that constructs a trace from a list of span prototypes
+	makeTrace := func(spanPrototypes []testSpan) ptrace.Traces {
+		trace := ptrace.NewTraces()
+		for _, spanProto := range spanPrototypes {
+			traceID := pcommon.TraceID([16]byte{0, 0, 0, 0, 0, 0, 0, 1})
+			span := ptrace.NewSpan()
+			span.SetTraceID(traceID)
+			span.SetSpanID(spanProto.id)
+			span.SetParentSpanID(spanProto.parent)
+			span.SetStartTimestamp(pcommon.NewTimestampFromTime(toTime(spanProto.startTime)))
+			span.SetEndTimestamp(pcommon.NewTimestampFromTime(toTime(spanProto.startTime + spanProto.duration)))
+
+			resource := ptrace.NewResourceSpans()
+
+			span.CopyTo(resource.ScopeSpans().AppendEmpty().Spans().AppendEmpty())
+			resource.CopyTo(trace.ResourceSpans().AppendEmpty())
+		}
+		return trace
+	}
+	rootSpanID := [8]byte{0, 0, 0, 0, 0, 0, 0, 1}
+
+	testCases := []struct {
+		description string
+		trace       []testSpan
+		expectedParents map[pcommon.SpanID]pcommon.SpanID
+		expectedStartTimes map[pcommon.SpanID]time.Time
+		expectedEndTimes map[pcommon.SpanID]time.Time
+	}{
+		{
+			description: "single span with dropped parent",
+			trace: []testSpan{
+				{id: [8]byte{2}, parent: [8]byte{1}, startTime: 0, duration: 100},
+			},
+			expectedParents: map[pcommon.SpanID]pcommon.SpanID{rootSpanID: pcommon.NewSpanIDEmpty(), [8]byte{1}:rootSpanID, [8]byte{2}:[8]byte{1},},
+			expectedStartTimes: map[pcommon.SpanID]time.Time{rootSpanID: toTime(0).UTC(), [8]byte{1}: toTime(0).UTC(), [8]byte{2}: toTime(0).UTC()},
+			expectedEndTimes: map[pcommon.SpanID]time.Time{rootSpanID: toTime(100).UTC(), [8]byte{1}: toTime(100).UTC(), [8]byte{2}: toTime(100).UTC()},
+
+		},
+		{
+			description: "two spans with dropped parent",
+			trace: []testSpan{
+				{id: [8]byte{2}, parent: [8]byte{1}, startTime: 0, duration: 100},
+				{id: [8]byte{3}, parent: [8]byte{1}, startTime: 110, duration: 100},
+			},
+			expectedParents: map[pcommon.SpanID]pcommon.SpanID{rootSpanID: pcommon.NewSpanIDEmpty(), [8]byte{1}: rootSpanID, [8]byte{2}: [8]byte{1}, [8]byte{3}: [8]byte{1}},
+			expectedStartTimes: map[pcommon.SpanID]time.Time{rootSpanID: toTime(0).UTC(), [8]byte{1}: toTime(0).UTC(), [8]byte{2}: toTime(0).UTC(), [8]byte{3}: toTime(110).UTC()},
+			expectedEndTimes: map[pcommon.SpanID]time.Time{rootSpanID: toTime(210).UTC(), [8]byte{1}: toTime(210).UTC(), [8]byte{2}: toTime(100).UTC(), [8]byte{3}: toTime(210).UTC()},
+		},
+		{
+			description: "multiple drops",
+			trace: []testSpan{
+				{id: [8]byte{2}, parent: [8]byte{1}, startTime: 0, duration: 100},
+				{id: [8]byte{4}, parent: [8]byte{3}, startTime: 10, duration: 50},
+			},
+			expectedParents: map[pcommon.SpanID]pcommon.SpanID{rootSpanID: pcommon.NewSpanIDEmpty(), [8]byte{1}: rootSpanID, [8]byte{2}: [8]byte{1}, [8]byte{3}: [8]byte{2}, [8]byte{4}: [8]byte{3}},
+			expectedStartTimes: map[pcommon.SpanID]time.Time{rootSpanID: toTime(0).UTC(), [8]byte{1}: toTime(0).UTC(), [8]byte{2}: toTime(0).UTC(), [8]byte{3}: toTime(10).UTC(), [8]byte{4}: toTime(10).UTC()},
+			expectedEndTimes: map[pcommon.SpanID]time.Time{rootSpanID: toTime(100).UTC(), [8]byte{1}: toTime(100).UTC(), [8]byte{2}: toTime(100).UTC(), [8]byte{3}: toTime(60).UTC(), [8]byte{4}: toTime(60).UTC()},
+		},
+	}
+
+	for _, tt := range testCases {
+		testCase := tt // capture loop var
+		t.Run(testCase.description, func(t *testing.T) {
+			trace := makeTrace(testCase.trace)
+			// dropped span adjustments require adding the root span
+			rootSpanAdjuster := AddRootSpan(true)
+			rootSpanAdjuster.Adjust(trace)
+
+			droppedSpanAdjuster := SynthesizeDroppedSpans(true)
+			droppedSpanAdjuster.Adjust(trace)
+
+			resources := trace.ResourceSpans()
+			for i := 0; i < resources.Len(); i++ {
+				resource := resources.At(i)
+				scopes := resource.ScopeSpans()
+				for j := 0; j < scopes.Len(); j++ {
+					spans := scopes.At(j).Spans()
+					for k := 0; k < spans.Len(); k++ {
+						span := spans.At(k)
+						assert.Equal(t, testCase.expectedParents[span.SpanID()], span.ParentSpanID())
+						assert.Equal(t, testCase.expectedStartTimes[span.SpanID()], span.StartTimestamp().AsTime())
+						assert.Equal(t, testCase.expectedEndTimes[span.SpanID()], span.EndTimestamp().AsTime())
+					}
+				}
+			}
+		})
+	}
+}
