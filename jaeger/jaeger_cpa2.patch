+// checks if the start and end parent haven't been adjusted
+// needed to see if a child should be adjust yet, or shouldn't because one of its parents hasn't been adjusted
+func (a *clockSkewAdjuster) parentsNotAdjusted(spanID pcommon.SpanID) bool {
+	if _, isRoot := a.roots[spanID]; isRoot {
+		return false
+	}
+	startParentID := a.spans[spanID].span.ParentSpanID()
+	endParentID := a.spans[spanID].endParent
+	if endParentID.IsEmpty() {
+		// if end parent is empty, we only consider the start parent for clock skew adjustments
+		endParentID = startParentID
+	}
+
+	if a.spans[startParentID].adjusted == false {
+		return true
+	}
+	if a.spans[endParentID].adjusted == false {
+		return true
+	}
+	return false
+}
+
+// since we consider both start and end parents, need to consider both of these to determine if we can use parent skew in child
+// only do so if the start and end parents have the same host key and the same skew
+// o.w., calculate skew for the child
+func (a *clockSkewAdjuster) useParentSkew(spanID pcommon.SpanID) bool {
+	if _, isRoot := a.roots[spanID]; isRoot {
+		return false
+	}
+	startParentID := a.spans[spanID].span.ParentSpanID()
+	endParentID := a.spans[spanID].endParent
+	if endParentID.IsEmpty() {
+		//invalid span id
+		endParentID = startParentID
+	}
+
+	startParentHostKey := a.spans[startParentID].hostKey
+	endParentHostKey := a.spans[endParentID].hostKey
+
+	startParentSkew := a.spans[startParentID].adjustment
+	endParentSkew := a.spans[endParentID].adjustment
+
+	if startParentHostKey == "" || endParentHostKey == "" {
+		return false
+	}
+
+	if startParentHostKey == endParentHostKey {
+		if startParentHostKey == a.spans[spanID].hostKey {
+			if startParentSkew == endParentSkew {
+				return true
+			}
+		}
+	}
+	return false
+}
