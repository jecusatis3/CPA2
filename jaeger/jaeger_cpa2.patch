+
+func TestSpanIDUniquifierEndParentUpdated(t *testing.T) {
+	traces := makeTraces()
+
+	//add another span with server as end parent
+	spans := traces.ResourceSpans().At(0).ScopeSpans().At(0).Spans()
+
+	yetAnotherSpan := spans.AppendEmpty()
+	yetAnotherSpan.SetTraceID(traceID)
+	yetAnotherSpan.SetSpanID(yetAnotherSpanID)
+	yetAnotherSpan.SetParentSpanID(anotherSpanID)
+	//times aren't specified here, but the idea is that this could be an asynchonous operation that has the third span above as its start parent
+	//and the server span as its end parent
+	addEndParentToSpan(&yetAnotherSpan, clientSpanID)
+
+	deduper := DeduplicateClientServerSpanIDs()
+	deduper.Adjust(traces)
+
+	//same as first test from above
+	clientSpan := spans.At(0)
+	assert.Equal(t, clientSpanID, clientSpan.SpanID(), "client span ID should not change")
+
+	serverSpan := spans.At(1)
+	assert.EqualValues(t, []byte{0, 0, 0, 0, 0, 0, 0, 3}, serverSpan.SpanID(), "server span ID should be reassigned")
+	assert.Equal(t, clientSpanID, serverSpan.ParentSpanID(), "next server span should be this server span's parent")
+
+	thirdSpan := spans.At(2)
+	assert.Equal(t, anotherSpanID, thirdSpan.SpanID(), "3rd span ID should not change")
+	assert.Equal(t, serverSpan.SpanID(), thirdSpan.ParentSpanID(), "parent of 3rd span should change to new spanID")
+
+	//new, to test that the end parent is updated
+	fourthSpan := spans.At(3)
+	assert.Equal(t, yetAnotherSpanID, fourthSpan.SpanID(), "4th span ID should not change")
+	assert.Equal(t, thirdSpan.SpanID(), fourthSpan.ParentSpanID(), "parent of 4th span should not change")
+	if ep, found := findEndParent(fourthSpan); !found {
+		assert.Fail(t, "4th span should have an end parent attribute")
+	} else {
+		assert.Equal(t, ep, serverSpan.SpanID(), "end parent of 4th span should change to new spanID")
+	}
+}
