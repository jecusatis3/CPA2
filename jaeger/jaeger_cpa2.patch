+
+// SynthesizeDroppedSpans creates an adjuster that synthesizes dropped spans to cover the duration of their children.
+// The synthesized dropped span is attached into the trace as a child of a span that covers its entire duration
+// This is a heuristic, but is intended to improve critical path analysis when spans are dropped as indicated in the CPA2 paper.
+func SynthesizeDroppedSpans(enabled bool) Adjuster {
+	return Func(func(traces ptrace.Traces) {
+		if !enabled {
+			return
+		}
+		adjuster := &droppedSpanAdjuster{
+			traces: traces,
+		}
+		adjuster.buildNodesMap()
+		adjuster.findDroppedSpans()
+	})
+}
+
+type droppedSpanAdjuster struct {
+	traces   ptrace.Traces
+	spans    map[pcommon.SpanID]*dsaNode
+	rootSpan ptrace.Span
+}
+
+type id_and_time struct {
+	ID pcommon.SpanID
+	time pcommon.Timestamp
+}
+
+type dsaNode struct {
+	span     ptrace.Span
+	endParent pcommon.SpanID
+	serviceName string
+	hostID string
+	hostIPs []string
+	hostIPString string
+	hostName string
+	children map[pcommon.SpanID]struct{}
+}
+
+type droppedNode struct {
+	serviceName string
+	startTime pcommon.Timestamp
+	endTime pcommon.Timestamp
+	hostID string
+	hostIPs []string
+	hostIPString string
+	hostName string
+	children map[pcommon.SpanID]struct{}
+}
+
+// buildNodesMap creates a mapping of span IDs to their corresponding nodes.
+func (a *droppedSpanAdjuster) buildNodesMap() {
+	a.spans = make(map[pcommon.SpanID]*dsaNode)
+	resources := a.traces.ResourceSpans()
+	for i := 0; i < resources.Len(); i++ {
+		resource := resources.At(i)
+		serviceName := getServiceName(resource)
+		hostID, hostIPs, hostIPString, hostName := getHostInformation(resource)
+		scopes := resource.ScopeSpans()
+		for j := 0; j < scopes.Len(); j++ {
+			spans := scopes.At(j).Spans()
+			for k := 0; k < spans.Len(); k++ {
+				span := spans.At(k)
+				ep, _ := findEndParent(span)
+				// track host information so that can also be used in dropped parent (if applicable)
+				a.spans[span.SpanID()] = &dsaNode{
+					span:    span,
+					endParent: ep,
+					serviceName: serviceName,
+					hostID: hostID,
+					hostIPs: hostIPs,
+					hostIPString: hostIPString,
+					hostName: hostName,
+					children: make(map[pcommon.SpanID]struct{}),
+				}
+				//check for root span
+				if span.ParentSpanID().IsEmpty() {
+					a.rootSpan = span
+				}
+			}
+		}
+	}
+}
+
+// finds all spans that are dropped and identify their duration to cover their children spans
+// then find a span to attach the synthesized dropped span to that covers its duration
+// pick the "lowest" span in hierarchy by excluding ancestors of candidates that cover the duration of the dropped span
+func (a *droppedSpanAdjuster) findDroppedSpans() {
+	droppedSpans := make(map[pcommon.SpanID]*droppedNode)
+	for spanID, n := range a.spans {
+		if spanID == a.rootSpan.SpanID() {
+			continue
+		}
+		startParent := n.span.ParentSpanID()
+		endParent := n.endParent
+		parents := []id_and_time {
+			{startParent, n.span.StartTimestamp()},
+			{endParent, n.span.EndTimestamp()},
+		}
+
+		// check if the span's start and end parents are in the span nodes map; if not, we assume it was dropped
+		for _, parent := range parents {
+			if parent.ID.IsEmpty() {
+				continue
+			}
+			if _, parentFound := a.spans[parent.ID]; !parentFound {
+				if synthesizedSpan, synthesizedSpanFound := droppedSpans[parent.ID]; !synthesizedSpanFound {
+					//create a span to synthesize the dropped one; actually add to trace later
+					droppedSpans[parent.ID] = &droppedNode{
+						serviceName: n.serviceName,
+						startTime: parent.time,
+						endTime: parent.time,
+						hostID: n.hostID,
+						hostIPs: n.hostIPs,
+						hostIPString: n.hostIPString,
+						hostName: n.hostName,
+						children: make(map[pcommon.SpanID]struct{}),
+					}
+				} else {
+					// extend start and end of synthesized span to cover the duration of its children
+					synthesizedSpan.startTime = min(synthesizedSpan.startTime, parent.time)
+					synthesizedSpan.endTime = max(synthesizedSpan.endTime, parent.time)
+				}
+				droppedSpans[parent.ID].children[spanID] = struct{}{}
+			} else {
+				a.spans[parent.ID].children[spanID] = struct{}{}
+			}
+		}
+	}
+
+	// find parent for dropped spans
+	// iterate from latest end time to earliest to add dropped spans higher in the hierarchy earlier, to handle cases where multiple spans are dropped in the same ancestry line
+	droppedSpanIDs := make([]pcommon.SpanID, 0, len(droppedSpans))
+	for droppedSpanID := range droppedSpans {
+		droppedSpanIDs = append(droppedSpanIDs, droppedSpanID)
+	}
+
+	slices.SortFunc(droppedSpanIDs, func(a,b pcommon.SpanID) int {
+		// compare function will return -1 if a's end time is before b's end time
+		// since we want to sort in descending order, negate compare function's ret val
+		return -droppedSpans[a].endTime.AsTime().Compare(droppedSpans[b].endTime.AsTime())
+	})
+
+	// now that span ids are sorted by reverse end time, use that to move through the map
+	for _, sortedDroppedSpanID := range droppedSpanIDs {
+		droppedSpanNode := droppedSpans[sortedDroppedSpanID]
+		excludedCandidates := make(map[pcommon.SpanID]struct{}) // use map with empty structures as set
+
+		// first, exclude all descendants of the dropped span from being parent candidates
+		descendants := make(map[pcommon.SpanID]struct{})
+		for childSpan := range droppedSpans[sortedDroppedSpanID].children {
+			descendants[childSpan] = struct{}{}
+		}
+
+		for len(descendants) > 0 {
+			currDescendant := pop(descendants)
+			excludedCandidates[currDescendant] = struct{}{}
+			if _, currDescendantInSpans := a.spans[currDescendant]; currDescendantInSpans {
+				for currDescendantChild := range a.spans[currDescendant].children {
+					descendants[currDescendantChild] = struct{}{}
+				}
+			} else if _, currDescendantInDroppedSpans := droppedSpans[currDescendant]; currDescendantInDroppedSpans {
+				for currDescendantChild := range droppedSpans[currDescendant].children {
+					descendants[currDescendantChild] = struct{}{}
+				}
+			}
+		}
+		parentCandidates := make(map[pcommon.SpanID]struct{})
+		for spanID, n := range a.spans {
+			if _, inExcluded := excludedCandidates[spanID]; !inExcluded {
+				// looking for spans that fully cover the synthesized dropped span
+				// exclude the ancestors of these candidates so that we get the "lowest" span in the trace hierarchy-wise that covers the duration of the span.
+				if n.span.StartTimestamp().AsTime().Compare(droppedSpanNode.startTime.AsTime()) <= 0 && droppedSpanNode.endTime.AsTime().Compare(n.span.EndTimestamp().AsTime()) <= 0 {
+					parentCandidates[spanID] = struct{}{}
+					ancestors := make(map[pcommon.SpanID]struct{})
+					ancestors[n.span.ParentSpanID()] = struct{}{}
+					// add end parent to ancestors only if it is not the invalid (empty) span id
+					if !n.endParent.IsEmpty() {
+						ancestors[n.endParent] = struct{}{}
+					}
+					for len(ancestors) > 0 {
+						currAncestor := pop(ancestors)
+						if currAncestor.IsEmpty() {
+							continue
+						}
+
+						if currAncestorNode, currAncestorInSpans := a.spans[currAncestor]; currAncestorInSpans {
+							excludedCandidates[currAncestor] = struct{}{}
+							ancestors[currAncestorNode.span.ParentSpanID()] = struct{}{}
+							if !currAncestorNode.endParent.IsEmpty() {
+								ancestors[currAncestorNode.endParent] = struct{}{}
+							}
+						} else {
+							// exclude spans that do not have an ancestry line to the root
+							excludedCandidates[spanID] = struct{}{}
+							break
+						}
+					}
+				}
+			}
+		}
+		// choose shortest candidate as the parent for the dropped span
+		shortestParent := a.rootSpan.SpanID()
+		shortestDuration := getSpanDuration(a.rootSpan)
+		for parentCandidate := range parentCandidates {
+			if _, parentCandidateInExcluded := excludedCandidates[parentCandidate]; !parentCandidateInExcluded {
+				parentCandidateDuration := getSpanDuration(a.spans[parentCandidate].span)
+				if parentCandidateDuration <= shortestDuration {
+					shortestDuration = parentCandidateDuration
+					shortestParent = parentCandidate
+				}
+			}
+		}
+
+		// add dropped span node to trace with shortest parent as its start and end parent
+		updatedResourceSpans := a.traces.ResourceSpans().AppendEmpty()
+		updatedResourceSpans.Resource().Attributes().PutStr(string(otelsemconv.ServiceNameKey), droppedSpanNode.serviceName)
+		if droppedSpanNode.hostID != "" {
+			updatedResourceSpans.Resource().Attributes().PutStr(string(otelsemconv.HostIDKey), droppedSpanNode.hostID)
+		}
+		if len(droppedSpanNode.hostIPs) > 0 {
+			IPsSlice := updatedResourceSpans.Resource().Attributes().PutEmptySlice(string(otelsemconv.HostIPKey))
+			for _, IP := range droppedSpanNode.hostIPs {
+			   IPsSlice.AppendEmpty().SetStr(IP)
+			}
+		}
+		if droppedSpanNode.hostIPString != "" {
+			updatedResourceSpans.Resource().Attributes().PutStr(string(otelsemconv.HostIPKey), droppedSpanNode.hostIPString)
+		}
+		if droppedSpanNode.hostName != "" {
+			updatedResourceSpans.Resource().Attributes().PutStr(string(otelsemconv.HostIDKey), droppedSpanNode.hostName)
+		}
+
+		scopeSpans := updatedResourceSpans.ScopeSpans().AppendEmpty()
+
+		span := scopeSpans.Spans().AppendEmpty()
+		span.SetTraceID(a.rootSpan.TraceID())
+		span.SetSpanID(sortedDroppedSpanID)
+		span.SetParentSpanID(shortestParent)
+		span.SetName("dropped")
+		span.SetStartTimestamp(droppedSpanNode.startTime)
+		span.SetEndTimestamp(droppedSpanNode.endTime)
+
+		// also create a dsa node for this span, so it can potentially be used as a parent for other dropped spans
+		a.spans[span.SpanID()] = &dsaNode{
+			span:    span,
+			endParent: shortestParent,
+			serviceName: droppedSpanNode.serviceName,
+			hostID: droppedSpanNode.hostID,
+			hostIPs: droppedSpanNode.hostIPs,
+			hostIPString: droppedSpanNode.hostIPString,
+			hostName: droppedSpanNode.hostName,
+			children: make(map[pcommon.SpanID]struct{}),
+		}
+		// copy children
+		for child := range droppedSpanNode.children {
+			a.spans[span.SpanID()].children[child] = struct{}{}
+		}
+
+		// and the dropped span to the children of the shortest parent
+		a.spans[shortestParent].children[span.SpanID()] = struct{}{}
+
+	}
+}
