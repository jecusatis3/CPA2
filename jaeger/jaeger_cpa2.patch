@@ -0,0 +1,136 @@
+package adjuster
+
+import (
+	"fmt"
+	"go.opentelemetry.io/collector/pdata/pcommon"
+	"go.opentelemetry.io/collector/pdata/ptrace"
+)
+
+// FillGapsAndExtendParents returns an adjuster that fills gaps that can occur between asynchronous operations and their parents
+// typical Jaeger UI code will drop spans like this that aren't covered by their parent at all
+// this adjustment is an alternative approach that won't omit those spans from the critical path.
+func FillGapsAndExtendParents(enabled bool) Adjuster {
+	return Func(func(traces ptrace.Traces) {
+		if !enabled {
+			return
+		}
+		adjuster := &fillGapsAndExtendAdjuster{
+			traces: traces,
+		}
+		adjuster.buildNodesMap()
+		adjuster.buildChildren()
+		adjuster.adjustParents()
+	})
+}
+
+type fillGapsAndExtendAdjuster struct {
+	traces   ptrace.Traces
+	spans    map[pcommon.SpanID]*fgeNode
+	rootSpan ptrace.Span
+	endParentThreshold int
+}
+
+type fgeNode struct {
+	span     *ptrace.Span
+	endParent pcommon.SpanID
+	children map[pcommon.SpanID]struct{}
+}
+
+// buildNodesMap creates a mapping of span IDs to their corresponding nodes.
+func (a *fillGapsAndExtendAdjuster) buildNodesMap() {
+	a.spans = make(map[pcommon.SpanID]*fgeNode)
+	resources := a.traces.ResourceSpans()
+	for i := 0; i < resources.Len(); i++ {
+		resource := resources.At(i)
+		scopes := resource.ScopeSpans()
+		for j := 0; j < scopes.Len(); j++ {
+			spans := scopes.At(j).Spans()
+			for k := 0; k < spans.Len(); k++ {
+				span := spans.At(k)
+				ep, _ := findEndParent(span)
+				a.spans[span.SpanID()] = &fgeNode{
+					span:    &span,
+					endParent: ep,
+					children: make(map[pcommon.SpanID]struct{}),
+				}
+				//check for root span
+				if span.ParentSpanID().IsEmpty() {
+					a.rootSpan = span
+				}
+			}
+		}
+	}
+}
+
+// buildChildren populates the children set in each node
+func (a *fillGapsAndExtendAdjuster) buildChildren() {
+	for _, n := range a.spans {
+		fmt.Println("span id: ", n.span.SpanID())
+		if n.span.ParentSpanID() == pcommon.NewSpanIDEmpty() { //don't consider end parent here, because NULL end parent is a valid case
+			continue
+		}
+
+		a.spans[n.span.ParentSpanID()].children[n.span.SpanID()] = struct{}{}
+		if !n.endParent.IsEmpty() {
+			a.spans[n.endParent].children[n.span.SpanID()] = struct{}{}
+		}
+	}
+}
+
+
+
+// extend the starts and ends of spans so that there are no gaps between the span and its start and end parent
+// that is, a span's start will always be covered by its start parent
+// and its end will always be covered by its end parent
+func (a *fillGapsAndExtendAdjuster) adjustParents() {
+	modStartTracker := make(map[pcommon.SpanID]pcommon.Timestamp)
+	a.extStart(a.rootSpan.SpanID(), getMaxTime(), modStartTracker)
+
+	modEndTracker := make(map[pcommon.SpanID]pcommon.Timestamp)
+	a.extEnd(a.rootSpan.SpanID(), getMinTime(), modEndTracker)
+
+	for spanID, n := range a.spans {
+		if !n.span.StartTimestamp().AsTime().Equal(modStartTracker[spanID].AsTime()) {
+			n.span.SetStartTimestamp(modStartTracker[spanID])
+		}
+		if !n.span.EndTimestamp().AsTime().Equal(modEndTracker[spanID].AsTime()) {
+			n.span.SetEndTimestamp(modEndTracker[spanID])
+		}
+	}
+
+}
+
+// extend starts of spans (if necessary)
+// first fill gaps from span to its start parent
+// then adjust the start of the span to cover the start of its children, if necessary
+func (a *fillGapsAndExtendAdjuster) extStart(spanID pcommon.SpanID, origParentEnd pcommon.Timestamp, modStartTracker map[pcommon.SpanID]pcommon.Timestamp) pcommon.Timestamp {
+	n := a.spans[spanID]
+	// first, handle gaps
+	modStart := minTime(n.span.StartTimestamp(), origParentEnd)
+	for c := range n.children {
+		// then, recurse through start children.  On way back up, we adjust ourselves to cover their start, if needed.
+		if a.spans[c].span.ParentSpanID() == spanID {
+			modStart = minTime(modStart, a.extStart(c, n.span.EndTimestamp(), modStartTracker))
+		}
+	}
+	modStartTracker[spanID] = modStart
+	return modStart
+}
+
+// extend ends of spans (if necessary)
+// first fill gaps from span to its end parent
+// then adjust the end of the span to cover the end of its children, if necessary
+func (a *fillGapsAndExtendAdjuster) extEnd(spanID pcommon.SpanID, origParentStart pcommon.Timestamp, modEndTracker map[pcommon.SpanID]pcommon.Timestamp) pcommon.Timestamp {
+	n := a.spans[spanID]
+	modEnd := maxTime(n.span.EndTimestamp(), origParentStart)
+	for c := range n.children {
+		if a.spans[c].endParent == spanID {
+			modEnd = maxTime(modEnd, a.extEnd(c, n.span.StartTimestamp(), modEndTracker))
+		} else if a.spans[c].endParent == pcommon.NewSpanIDEmpty() {
+			// if the end parent of the child is invalid, don't worry about adjusting this span to cover the end of the child
+			a.extEnd(c, n.span.StartTimestamp(), modEndTracker)
+		}
+	}
+	modEndTracker[spanID] = modEnd
+	return modEnd
+}
