+package adjuster
+
+import (
+	"go.opentelemetry.io/collector/pdata/pcommon"
+	"go.opentelemetry.io/collector/pdata/ptrace"
+)
+
+// AddRootSpan creates an adjuster that adds a root span to the trace that covers the duration of all children spans.
+// Children spans with an emprt parent use the root span as their parent, so this root span should be the only "root" (span without a parent) in the trace
+func AddRootSpan(enabled bool) Adjuster {
+	return Func(func(traces ptrace.Traces) {
+		if !enabled {
+			return
+		}
+		adjuster := &rootSpanAdjuster{
+			traces: traces,
+		}
+		adjuster.createRootSpan()
+	})
+}
+
+type rootSpanAdjuster struct{
+	traces ptrace.Traces
+}
+
+// iterate through all spans to find the earliest start and latest end
+// this indicates the duration of the root span
+// also attach all spans with an empty parent to the root span
+// so the only span with an empty parent after this pass should be the root span that we add
+func (a *rootSpanAdjuster) createRootSpan() {
+	minStart := getMaxTime()
+	maxEnd := getMinTime()
+	traceID := pcommon.NewTraceIDEmpty()
+	rootSpanChildren := make(map[*ptrace.Span]struct{})
+	allSpanIDs := make(map[pcommon.SpanID]struct{})
+
+	resourceSpans := a.traces.ResourceSpans()
+	for i := 0; i < resourceSpans.Len(); i++ {
+		rs := resourceSpans.At(i)
+		scopeSpans := rs.ScopeSpans()
+		for j := 0; j < scopeSpans.Len(); j++ {
+			ss := scopeSpans.At(j)
+			spans := ss.Spans()
+			for k := 0; k < spans.Len(); k++ {
+				span := spans.At(k)
+
+				//add id to set of all span ids, used to check if root span id is already taken
+				allSpanIDs[span.SpanID()] = struct{}{}
+
+				//get trace id from first span
+				if traceID.IsEmpty() {
+					traceID = span.TraceID()
+				}
+				//if span doesn't have a parent, its parent will be the root span that we are adding
+				if span.ParentSpanID() == pcommon.NewSpanIDEmpty() {
+					//actually attach later once the root span id is set
+					rootSpanChildren[&span] = struct{}{}
+				}
+				spanStartTime := span.StartTimestamp()
+				spanEndTime := span.EndTimestamp()
+				if spanStartTime.AsTime().Before(minStart.AsTime()) {
+					minStart = spanStartTime
+				}
+				if spanEndTime.AsTime().After(maxEnd.AsTime()) {
+					maxEnd = spanEndTime
+				}
+			}
+		}
+	}
+
+	// get root span id; is 0000000000000001 by default but is incremented if that already exists in the trace
+	rootSpanID := getRootSpanID(allSpanIDs)
+
+	// set root span as parent for all spans without parent
+	for rootSpanChild := range rootSpanChildren {
+		rootSpanChild.SetParentSpanID(rootSpanID)
+	}
+
+	// add the root span to the trace
+	updatedResourceSpans := a.traces.ResourceSpans().AppendEmpty()
+	updatedResourceSpans.Resource().Attributes().PutStr("service.name", "ROOT")
+
+	scopeSpans := updatedResourceSpans.ScopeSpans().AppendEmpty()
+
+	span := scopeSpans.Spans().AppendEmpty()
+	span.SetTraceID(traceID)
+	span.SetSpanID(rootSpanID)
+	span.SetParentSpanID(pcommon.NewSpanIDEmpty())
+	span.SetName("ROOT")
+	span.SetStartTimestamp(pcommon.NewTimestampFromTime(minStart.AsTime()))
+	span.SetEndTimestamp(pcommon.NewTimestampFromTime(maxEnd.AsTime()))
+}
