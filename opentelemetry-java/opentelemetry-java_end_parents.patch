@@ -0,0 +1,89 @@
+/*
+ * Copyright The OpenTelemetry Authors
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package io.opentelemetry.instrumentation.api.internal;
+
+import io.opentelemetry.api.trace.Span;
+import io.opentelemetry.api.trace.SpanContext;
+import io.opentelemetry.context.Context;
+import io.opentelemetry.context.ContextStorage;
+import io.opentelemetry.context.Scope;
+import java.util.ArrayDeque;
+import java.util.function.Function;
+import javax.annotation.Nullable;
+
+/**
+ * Adds the "end_parent" attribute to a span when the span that is active when it ends differs from
+ * its start parent. Mirrors Span::End() of the opentelemetry-cpp end parent patch.
+ *
+ * <p>This class is internal and is hence not for public use. Its APIs are unstable and can change
+ * at any time.
+ */
+public final class EndParentTracker {
+
+  // returns the start parent of an SDK span; set by the agent, which can see the SDK classes
+  private static volatile Function<Span, SpanContext> parentLookup = span -> null;
+  // per-thread stack of attached contexts (C++: ThreadLocalContextStorage's stack)
+  private static final ThreadLocal<ArrayDeque<Context>> contextStack =
+      ThreadLocal.withInitial(ArrayDeque::new);
+
+  public static void setParentLookup(Function<Span, SpanContext> lookup) {
+    parentLookup = lookup;
+  }
+
+  /** Called right before {@code span.end()}. */
+  public static void onEnding(Span span) {
+    SpanContext parent = parentLookup.apply(span);
+    // remote parents are skipped: in the C++ traces, spans with a remote parent never get one
+    if (parent == null || parent.isRemote()) {
+      return;
+    }
+    String active = Span.current().getSpanContext().getSpanId();
+    // if the span being ended is still active, use the next context in the stack
+    if (active.equals(span.getSpanContext().getSpanId())) {
+      active = topNext();
+    }
+    if (!active.equals(parent.getSpanId())) {
+      span.setAttribute("end_parent", active);
+    }
+  }
+
+  // C++: RuntimeContext::GetCurrentParent() -> Stack::TopNext()
+  private static String topNext() {
+    Context next = null;
+    int i = 0;
+    for (Context context : contextStack.get()) { // iterates from the top of the stack
+      if (i++ == 1) {
+        next = context;
+        break;
+      }
+    }
+    return Span.fromContext(next == null ? Context.root() : next).getSpanContext().getSpanId();
+  }
+
+  /** Wraps the context storage so that attached contexts are also kept on a stack. */
+  public static ContextStorage wrapContextStorage(ContextStorage delegate) {
+    return new ContextStorage() {
+      @Override
+      public Scope attach(Context toAttach) {
+        Scope scope = delegate.attach(toAttach);
+        ArrayDeque<Context> stack = contextStack.get();
+        stack.push(toAttach);
+        return () -> {
+          stack.removeFirstOccurrence(toAttach);
+          scope.close();
+        };
+      }
+
+      @Nullable
+      @Override
+      public Context current() {
+        return delegate.current();
+      }
+    };
+  }
+
+  private EndParentTracker() {}
+}
